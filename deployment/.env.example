# PREDICTA – Environment Variables Template
# Copy this file to .env and fill in your real values
# NEVER commit .env to Git

# ── Flask ──────────────────────────────────────────────────────────────────
SECRET_KEY=predicta-change-this-secret-in-production
JWT_SECRET_KEY=predicta-jwt-change-this-in-production
FLASK_DEBUG=False

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://predicta:predicta123@localhost:5432/predicta_db

# ── MQTT Broker ────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# MQTT_USERNAME=your_mqtt_user
# MQTT_PASSWORD=your_mqtt_password

# ── Email Alerts (Gmail App Password recommended) ──────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_FROM=predicta-alerts@gmail.com
ALERT_EMAILS=engineer@company.com,manager@company.com

# ── Telegram Alerts ────────────────────────────────────────────────────────
# Create bot: https://t.me/BotFather → /newbot
# Get chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── ML Model ──────────────────────────────────────────────────────────────
ML_MODEL_PATH=ml_model/saved_models/
ML_SCALER_PATH=ml_model/saved_models/scaler.pkl

# ── Reports ────────────────────────────────────────────────────────────────
REPORT_OUTPUT_DIR=reports/
