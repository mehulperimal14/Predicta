# PREDICTA 2.0 – Production & Development Environment Configuration
# Copy this file to .env and configure your environment variables.
# NEVER commit your production .env with real credentials to GitHub.

# ── Flask & Security ──────────────────────────────────────────────────────────
# Generate each secret with:  python -c "import secrets; print(secrets.token_hex(32))"
# Left empty locally, the backend generates random keys in backend/instance/.
# Docker Compose refuses to start until both are set.
SECRET_KEY=
JWT_SECRET_KEY=
FLASK_ENV=development                  # set to "production" when deployed
FLASK_DEBUG=False
PORT=5000

# ── Initial user passwords ────────────────────────────────────────────────────
# Production: unset → a random password is printed once to the server log.
# Development: unset → demo passwords (admin/Predicta@2024 etc.).
# If an existing account still has its demo password, it is rotated to the value here.
PREDICTA_ADMIN_PASSWORD=
PREDICTA_ENGINEER_PASSWORD=
PREDICTA_OPERATOR_PASSWORD=

# ── Segment B: Live IoT Monitoring ────────────────────────────────────────────
# Devices stream over HTTPS to /api/live/ingest with their X-Device-Key.
# Enable the MQTT bridge only if a broker is reachable from the backend.
MQTT_ENABLED=False
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
LIVE_ASSESSMENT_EVERY_N_READINGS=10
LIVE_ASSESSMENT_WINDOW_READINGS=720
LIVE_OFFLINE_AFTER_SECONDS=60

# ── Database ──────────────────────────────────────────────────────────────────
# Default is SQLite for local development; use PostgreSQL for production deployment
DATABASE_URL=sqlite:///predicta.db
# DATABASE_URL=postgresql://predicta:predicta123@localhost:5432/predicta_db

# ── Universal File Uploads (PLC/SCADA Ingestion) ──────────────────────────────
UPLOAD_FOLDER=uploads/
MAX_CONTENT_LENGTH=104857600  # 100 MB max file size

# ── Telegram Bot Alerts ───────────────────────────────────────────────────────
# 1. Create a bot with @BotFather on Telegram (send /newbot)
# 2. Add bot to group or message it directly
# 3. Retrieve chat ID via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Twilio SMS Alerts ─────────────────────────────────────────────────────────
# Reserved for high-priority and critical stoppage events
# In mock mode, SMS alerts are safely logged to the delivery audit trail
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_RECIPIENTS=

# ── Notification Dispatch Policies ────────────────────────────────────────────
NOTIFICATION_MOCK_MODE=True            # Safe logging when provider keys are unset
NOTIFICATION_COOLDOWN_MINUTES=15       # Per-asset deduplication window
ALLOW_HISTORICAL_REPLAY=False          # Replay guard: keeps old file uploads from spamming live channels

# ── Email Alerts (Optional SMTP) ──────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=alerts@predicta.local
ALERT_EMAILS=

# ── Machine Learning & Reporting ──────────────────────────────────────────────
ML_MODEL_PATH=ml_model/saved_models/
REPORT_OUTPUT_DIR=reports/
